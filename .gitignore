# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

supabase/scripts/data/

# Supabase CLI local metadata (project ref, pooler URL shape, cached
# versions) - no credentials, but regenerated per-machine and not meant to
# be committed, matching Supabase CLI's own recommended .gitignore entry.
supabase/.temp/