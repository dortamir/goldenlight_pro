{
  "expo": {
    "name": "goldenlight-pro",
    "slug": "goldenlight-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/golden-plus-icon.png",
    "scheme": "goldenlightpro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/golden-plus-icon.png",
      "bundleIdentifier": "com.dortamir.goldenlightpro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dortamir.goldenlightpro",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E0E",
        "foregroundImage": "./assets/images/golden-plus-android-foreground.png",
        "backgroundImage": "./assets/images/golden-plus-android-background.png",
        "monochromeImage": "./assets/images/golden-plus-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/golden-plus-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E0E",
          "image": "./assets/images/golden-plus-splash.png",
          "imageWidth": 300
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "האפליקציה זקוקה לגישה לתמונות כדי להעלות חשבונית או תמונת פרופיל.",
          "cameraPermission": "האפליקציה זקוקה לגישה למצלמה כדי לצלם חשבונית.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1be17fa0-4e7b-41fc-aa1d-724bda814207"
      }
    },
    "owner": "dortamir"
  }
}
